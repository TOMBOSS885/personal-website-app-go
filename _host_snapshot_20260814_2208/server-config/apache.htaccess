Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Protect PHP source, deployment material, and files that commonly contain
# credentials or database contents when the host cannot place them above web root.
RewriteRule ^(?:app|config|migrations|server-config)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
RewriteRule (^|/)(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|phpunit\.xml(?:\.dist)?|web\.config)$ - [F,L,NC]
RewriteRule \.(?:bak|conf|dist|env|ini|log|old|orig|pem|key|sql|sqlite3?|swp|ya?ml)(?:\.|$) - [F,L,NC]

# Static frontend articles must pass through the signed PHP resource route.
RewriteRule ^uploads/article-sites(?:/|$) - [F,L,NC]

# Route all API calls through the PHP front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(?:/(.*))?$ api/index.php?route=$1 [QSA,L]

# Dynamic crawler resources must not fall through to the React shell.
RewriteRule ^robots\.txt$ api/index.php?route=robots.txt [QSA,L]
RewriteRule ^sitemap\.xml$ api/index.php?route=sitemap.xml [QSA,L]
RewriteRule ^feed\.xml$ api/index.php?route=feed.xml [QSA,L]
RewriteRule ^atom\.xml$ api/index.php?route=atom.xml [QSA,L]

# Existing static assets and uploads are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React BrowserRouter fallback.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set X-XSS-Protection "0"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'"
  <Files "index.html">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <FilesMatch "\.(?:js|css|png|jpe?g|gif|webp|svg|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript application/json image/svg+xml application/octet-stream
  <FilesMatch "\.(?:js|css|json|svg|moc3)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>
